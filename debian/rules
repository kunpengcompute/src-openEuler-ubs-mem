#!/usr/bin/make -f

export DH_VERBOSE=1
export CI_BUILD=ON
export DEB_BUILD_MAINT_OPTIONS=optimize=-lto

%:
	dh $@

override_dh_auto_clean:
	@echo ">>> Cleaning build..."
	rm -rf build

override_dh_auto_configure:
	@echo ">>> Skip configure"

override_dh_auto_build:
	@echo ">>> Building project..."
	DEB_MULTIARCH=$$(dpkg-architecture -qDEB_HOST_MULTIARCH); \
	bash build.sh -t relwithdebinfo -f "-DARCH_LIB_DIR=/usr/lib/$$DEB_MULTIARCH -DSYS_LIB_DIR=/usr/lib/$$DEB_MULTIARCH"

override_dh_auto_test:
	@echo ">>> Skip test"

override_dh_auto_install:
	@echo ">>> Installing to debian tmp directories..."

	install -Dm755 build/relwithdebinfo/output/bin/ubsmd \
		debian/tmp/usr/bin/ubsmd
	install -Dm644 build/relwithdebinfo/output/lib/libubsm_sdk.so.1.0.0 \
		debian/tmp/usr/lib/aarch64-linux-gnu/libubsm_sdk.so.1.0.0
	ln -sf libubsm_sdk.so.1.0.0 debian/tmp/usr/lib/aarch64-linux-gnu/libubsm_sdk.so.1
	ln -sf libubsm_sdk.so.1 debian/tmp/usr/lib/aarch64-linux-gnu/libubsm_sdk.so
	install -Dm644 build/relwithdebinfo/output/lib/libubsmd.so \
		debian/tmp/usr/lib/aarch64-linux-gnu/ubs_mem/libubsmd.so
	install -Dm644 build/relwithdebinfo/output/config/ubsmd.conf \
		debian/tmp/etc/ubs_mem/ubsmd.conf
	install -Dm644 build/relwithdebinfo/output/include/ubs_mem.h \
		debian/tmp/usr/include/ubs_mem/ubs_mem.h
	install -Dm644 build/relwithdebinfo/output/include/ubs_mem_def.h \
		debian/tmp/usr/include/ubs_mem/ubs_mem_def.h
	install -Dm644 build/relwithdebinfo/output/script/ubsmd.service \
		debian/tmp/usr/lib/systemd/system/ubsmd.service
	sed -i \
		-e "s|^Environment=.*|Environment=LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu/ubs_mem:/usr/lib/aarch64-linux-gnu|" \
		-e "s|^ExecStart=.*|ExecStart=/usr/bin/ubsmd --runtime=/usr/lib/aarch64-linux-gnu/ubs_mem --config=/etc/ubs_mem/ubsmd.conf|" \
		debian/tmp/usr/lib/systemd/system/ubsmd.service

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info

override_dh_installsystemd:
	dh_installsystemd --no-start
