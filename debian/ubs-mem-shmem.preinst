#!/bin/bash
set -e

create_user_and_group() {
    if ! getent group ubsmd > /dev/null; then
        groupadd --system ubsmd
    fi

    if ! getent passwd ubsmd > /dev/null; then
        useradd --system -g ubsmd --no-create-home --shell /sbin/nologin ubsmd
    fi

    usermod -a -G ubse ubsmd 2>/dev/null || true
}

stop_old_service() {
    if [ -e /usr/lib/systemd/system/ubsmd.service ]; then
        if command -v deb-systemd-invoke >/dev/null 2>&1; then
            deb-systemd-invoke stop ubsmd.service >/dev/null 2>&1 || true
        fi
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper disable ubsmd.service >/dev/null 2>&1 || true
        fi
        rm -f /usr/lib/systemd/system/ubsmd.service
    fi
}

case "$1" in
    install|upgrade)
        stop_old_service
        create_user_and_group
        ;;
esac

#DEBHELPER#
