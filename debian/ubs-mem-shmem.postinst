#!/bin/bash
set -e

set_ownership() {
    chown ubsmd:ubsmd /etc/ubs_mem /etc/ubs_mem/ubsmd.conf 2>/dev/null || true
}

create_log_directory() {
    mkdir -p /var/log/ubsm/
    chown ubsmd:ubsmd /var/log/ubsm 2>/dev/null || true
}

case "$1" in
    configure)
        set_ownership
        create_log_directory
        ;;
esac

#DEBHELPER#
